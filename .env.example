# =================================
# Environment Configuration
# =================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# =================================
# API Configuration
# =================================

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# API Keys and Authentication
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# =================================
# Database Configuration
# =================================

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/dental_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dental_rag_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=dental_rag

# Vector Database (Chroma)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/vector_db

# =================================
# AI/ML Services
# =================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Google AI (Gemini) Configuration
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GOOGLE_AI_MODEL=gemini-pro

# Azure OpenAI (Alternative)
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# =================================
# File Storage & Processing
# =================================

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.pdf,.txt,.md,.docx
UPLOAD_DIR=./uploads

# OCR Service Configuration
OCR_SERVICE_URL=http://localhost:5000
OCR_API_KEY=your_ocr_api_key_here

# =================================
# External Services
# =================================

# PubMed API
PUBMED_API_KEY=your_pubmed_api_key_here
PUBMED_EMAIL=your_email@domain.com

# Google Cloud Services
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json

# =================================
# Security & CORS
# =================================

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =================================
# Logging & Monitoring
# =================================

# Log Configuration
LOG_LEVEL=info
LOG_FORMAT=combined

# Sentry (Error Monitoring)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# =================================
# Development Tools
# =================================

# Next.js Development
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_DEBUG_MODE=false

# Testing
JEST_TIMEOUT=30000
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/dental_rag_test

# =================================
# Performance & Caching
# =================================

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here

# Cache Configuration
CACHE_TTL=3600
ENABLE_CACHING=true

# =================================
# Email Configuration (Optional)
# =================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# =================================
# Feature Flags
# =================================

# Enable/Disable Features
ENABLE_USER_REGISTRATION=true
ENABLE_ADMIN_PANEL=true
ENABLE_DOCUMENT_UPLOAD=true
ENABLE_CHAT_HISTORY=true
ENABLE_ANALYTICS=false